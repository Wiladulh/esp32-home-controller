# Verify TLS with the Mozilla root bundle embedded in firmware (no user CA file needed)
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# Enable MQTT over WebSocket Secure
CONFIG_MQTT_TRANSPORT_WSS=y
CONFIG_MQTT_TRANSPORT_WEBSOCKET=y

# Store panic core dumps in the dedicated flash partition.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_STACK_SIZE=1792
